# Copy to .env and generate unique secrets before starting.
TZ=Europe/Berlin

POSTGRES_USER=agentforge
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
POSTGRES_DB=agentforge

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
N8N_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_RANDOM_SECRET
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

AP_DB_NAME=activepieces
AP_DB_USER=activepieces
AP_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
AP_ENCRYPTION_KEY=REPLACE_WITH_32_HEX_CHARACTERS
AP_JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
AP_FRONTEND_URL=http://localhost:8080

# Bind proxy to loopback by default. Change only behind a firewall.
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
