        "options": {}
      },
      "id": "c2d99e4d-7f4e-4c88-9ad8-1d3f8a6e0001",
      "name": "Incoming AI Task",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "agentforge-local-ai-task"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst task = typeof body.task === 'string' ? body.task.trim() : '';\nif (!task || task.length > 12000) throw new Error('task must be a non-empty string up to 12000 characters');\nreturn [{ json: { task, language: body.language === 'en' ? 'en' : 'de', mode: body.mode === 'code' ? 'code' : 'analysis' } }];"
      },
      "id": "c2d99e4d-7f4e-4c88-9ad8-1d3f8a6e0002",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'qwen2.5-coder:7b', prompt: 'Return concise JSON with keys summary, findings, recommendations. Task: ' + $json.task, stream: false, format: 'json' } }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "c2d99e4d-7f4e-4c88-9ad8-1d3f8a6e0003",
      "name": "Local Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.response ?? '';\nlet result;\ntry { result = JSON.parse(raw); } catch { throw new Error('Ollama did not return valid JSON'); }\nif (!result || typeof result !== 'object' || Array.isArray(result)) throw new Error('Invalid structured result');\nreturn [{ json: { status: 'completed', model: 'qwen2.5-coder:7b', ...result } }];"
      },
      "id": "c2d99e4d-7f4e-4c88-9ad8-1d3f8a6e0004",
      "name": "Validate JSON Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
