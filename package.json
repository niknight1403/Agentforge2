{
  "name": "villaforge-hub",
  "version": "1.60.0",
  "private": true,
  "type": "module",
  "description": "VillaForge Hub – Deep-Agent-Villa mit 1000 Agenten, kostenlosem LLM-Routen-Rotator und Gedaechtnis",
  "scripts": {
    "check": "node scripts/check.mjs",
    "start": "node server/server.mjs",
    "dev": "node --watch scripts/dev.mjs",
    "daemon": "bash scripts/daemon.sh start",
    "daemon:stop": "bash scripts/daemon.sh stop",
    "daemon:status": "bash scripts/daemon.sh status",
    "test:llm": "node server/scripts/llm-smoke.mjs",
    "test": "node --import ./server/tests/_env.mjs --test server/tests/*.test.mjs",
    "test:live": "node scripts/live-e2e.mjs",
    "test:design": "node scripts/design-audit.mjs",
    "build:web": "node scripts/build-web.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "stripe": "23.0.1"
  }
}
