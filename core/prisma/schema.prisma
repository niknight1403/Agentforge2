// Agentforge2 Core — Persistenz-Schema (PostgreSQL via Prisma)
// Aufgaben- und Checkpoint-Verwaltung des Multi-Agenten-Systems.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

model AgentTask {
  id          String            @id @default(uuid())
  title       String
  status      TaskStatus        @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  steps       AgentStep[]
  checkpoints AgentCheckpoint[]
}

model AgentStep {
  id         String    @id @default(uuid())
  taskId     String
  task       AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId    String
  stepNumber Int
  toolName   String
  arguments  Json
  result     Json?
  error      String?
  createdAt  DateTime  @default(now())

  @@index([taskId, stepNumber])
}

model AgentCheckpoint {
  id            String    @id @default(uuid())
  taskId        String
  task          AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId       String
  stepNumber    Int
  stateSnapshot Json
  createdAt     DateTime  @default(now())

  @@index([taskId, stepNumber])
}

// Full-Stack-Engine: ein generiertes Projekt mit seinem verifizierten Stand.
// Die Laufzeit des Hubs fuehrt denselben Stand in SQLite (server/fullstack),
// dieses Modell ist die persistente Sicht fuer Supervisor und Telemetrie.
model GeneratedProject {
  id              String   @id @default(uuid())
  slug            String   @unique
  blueprintDigest String
  requestDigest   String
  status          String   @default("PLANNED")
  files           Int      @default(0)
  testsPassed     Int      @default(0)
  repairs         Int      @default(0)
  commitHash      String?
  taskId          String?
  agentId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
}
