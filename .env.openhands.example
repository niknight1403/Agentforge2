# Copy to .env.openhands and replace the placeholder with a strong random value.
# Limit PROJECTS_PATH to a dedicated directory containing only agent-accessible projects.
PROJECTS_PATH=./openhands-projects
OPENHANDS_STATE_PATH=./.openhands
OPENHANDS_PORT=8000
LOCAL_BACKEND_API_KEY=replace-with-a-strong-random-secret
# Browser-reachable URL configured separately in the VillaForge Hub environment:
# OPENHANDS_CANVAS_URL=https://agents.example.com/canvas
