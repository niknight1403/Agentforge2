# deploy.sh fills missing secrets without overwriting existing values.
COMPOSE_PROJECT_NAME=villaforge
# Empty uses HTTP for first boot. A real DNS name enables automatic HTTPS.
CADDY_DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443
HUB_BIND_PORT=12000
VF_MEM_LIMIT=512m
NODE_OPTIONS=--max-old-space-size=320
VF_ADMIN_EMAIL=admin@villaforge.local
VF_ADMIN_PASSWORD=
VF_OPEN_MODE=0
VF_MAX_CONCURRENCY=1
VF_RESUME=1
VF_FOCUS_MODE=1
POSTGRES_USER=villaforge
POSTGRES_DB=villaforge
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=
# PostgreSQL is provisioned for new services; existing Hub data remains SQLite.
DATABASE_URL=
WEBHOOK_INTERNAL_TOKEN=
WEBHOOK_API_KEYS=
STRIPE_WEBHOOK_SECRET=
DIGISTORE24_PASSPHRASE=
SLACK_WEBHOOK_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_KEY=
OLLAMA_API_KEY=
VF_GEMINI_MODEL=auto
VF_GROQ_MODEL=llama-3.3-70b-versatile
VF_HF_MODEL=auto
# Local means reachable FROM the Hub container; loopback is that container.
VF_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
VF_LOCAL_LLM_MODEL=auto
VF_LOCAL_LLM_SECONDARY_URL=http://127.0.0.1:1234/v1
VF_LOCAL_LLM_SECONDARY_MODEL=auto
VF_LLM_CLOUD_TIMEOUT_MS=8000
VF_LLM_CLOUD_BUDGET_MS=24000
OLLAMA_MAX_PARALLEL=1
# Optional existing remote worker endpoints, never provision paid GPUs implicitly.
MODAL_BASE_URL=
MODAL_MODEL=
MODAL_API_KEY=
VF_REMOTE_WORKER_URL=
VF_REMOTE_WORKER_TOKEN=
VF_REMOTE_WORKER_PROTOCOL=json
VF_REMOTE_WORKER_API=predict
VF_REMOTE_WORKER_TIMEOUT_MS=120000
