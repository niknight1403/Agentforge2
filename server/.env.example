# Optional existing cloud credentials. Never commit real values.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_KEY=
FAL_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
ZHIPU_API_KEY=
CHUTES_API_KEY=
HYPERBOLIC_API_KEY=
TOGETHER_API_KEY=
# Optional model overrides; provider access/credits still apply.
VF_GEMINI_MODEL=gemini-3.5-flash-lite
# Prevent automatic use of paid, credit-based, or unknown routes.
VF_LLM_FREE_ONLY=1
# Optional remote Ollama/LM Studio hosts (HTTPS only); comma-separated exact hostnames.
# Loopback remains local automatically; remote hosts are never trusted by provider name alone.
VF_SELF_HOSTED_ALLOWED_HOSTS=
# Conservative local rate-limit defaults; tune to the provider/account quotas.
VF_RPM_GEMINI=8
VF_RPM_GROQ=20
VF_RPM_CEREBRAS=10
VF_RPM_MISTRAL=5
VF_RPM_OPENROUTER=12
VF_RPM_XAI=5
VF_RPM_POLLINATIONS=6
# Optional overrides for other providers: VF_RPM_SAMBANOVA, VF_RPM_NVIDIA, VF_RPM_ZHIPU, VF_RPM_CHUTES, VF_RPM_HYPERBOLIC, VF_RPM_TOGETHER
VF_RPM_DEFAULT=30
VF_GROQ_MODEL=openai/gpt-oss-120b
# VF_HF_MODEL=
# xAI is opt-in; configure model and existing key together (not a free-tier guarantee).
# XAI_API_KEY=
# VF_XAI_MODEL=
# xAI reasoning requests default to 6 minutes; supported range is 1-3600 seconds.
# VF_XAI_TIMEOUT_MS=360000
VF_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
VF_LOCAL_LLM_MODEL=auto
VF_LOCAL_LLM_SECONDARY_URL=http://127.0.0.1:1234/v1
VF_LOCAL_LLM_SECONDARY_MODEL=auto
VF_LLM_CLOUD_TIMEOUT_MS=8000
VF_LLM_CLOUD_BUDGET_MS=24000
OLLAMA_MAX_PARALLEL=1
# Bound local model waits so cloud failover and other villas remain responsive.
VF_LLM_LOCAL_TIMEOUT_MS=15000
VF_LLM_LOCAL_QUEUE_WAIT_MS=5000
VF_LLM_CIRCUIT_FAILURES=3
VF_LLM_CIRCUIT_RESET_MS=30000
# Optional durable agent mesh and CyberSarah metadata telemetry bridge.
VF_AGENT_EVENT_STREAM=vf:agent-events
CYBERSARAH_TELEMETRY_URL=
CYBERSARAH_TELEMETRY_TOKEN=
# GitHub push -> deterministic changelog -> Telegram Bot API (optional)
# Create a repository webhook for push events and use the identical secret here.
GITHUB_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional link to a separately self-hosted OpenHands Agent Canvas.
# Use a URL reachable from the user's browser (for local installs, http://127.0.0.1:8000/canvas).
OPENHANDS_CANVAS_URL=
# Optional link to a separately self-hosted OpenHands Agent Canvas.
# Use a URL reachable from the user's browser (for a local install, often http://127.0.0.1:8000/canvas).
OPENHANDS_CANVAS_URL=
