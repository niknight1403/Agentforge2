# Optional existing cloud credentials. Never commit real values.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
# Optional model overrides; provider access/credits still apply.
VF_GEMINI_MODEL=gemini-3.5-flash-lite
# Prevent automatic use of paid, credit-based, or unknown routes.
VF_LLM_FREE_ONLY=1
VF_GROQ_MODEL=openai/gpt-oss-120b
# VF_HF_MODEL=
# xAI is opt-in; configure model and existing key together (not a free-tier guarantee).
# XAI_API_KEY=
# VF_XAI_MODEL=
VF_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
VF_LOCAL_LLM_MODEL=auto
VF_LOCAL_LLM_SECONDARY_URL=http://127.0.0.1:1234/v1
VF_LOCAL_LLM_SECONDARY_MODEL=auto
VF_LLM_CLOUD_TIMEOUT_MS=8000
VF_LLM_CLOUD_BUDGET_MS=24000
OLLAMA_MAX_PARALLEL=1
# GitHub push -> deterministic changelog -> Telegram Bot API (optional)
# Create a repository webhook for push events and use the identical secret here.
GITHUB_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional link to a separately self-hosted OpenHands Agent Canvas.
# Use a URL reachable from the user's browser (for local installs, http://127.0.0.1:8000/canvas).
OPENHANDS_CANVAS_URL=
# Optional link to a separately self-hosted OpenHands Agent Canvas.
# Use a URL reachable from the user's browser (for a local install, often http://127.0.0.1:8000/canvas).
OPENHANDS_CANVAS_URL=
